<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f4f7f5;
    color: #123;
}

.top-languages {
    background: #063d25;
    padding: 10px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 7px;
}

.top-languages button {
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    background: #0b6b3d;
    color: white;
    font-weight: bold;
    cursor: pointer;
}

.top-languages button:hover {
    background: #b7ff35;
    color: #063d25;
}

header {
    background: linear-gradient(135deg, #063d25, #0b6b3d);
    color: white;
    text-align: center;
    padding: 25px 15px;
}

header h1 {
    margin: 0 0 8px;
    font-size: 32px;
}

header p {
    margin: 0;
    font-size: 17px;
}

nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #075b34;
    padding: 10px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 7px;
}

nav a {
    color: white;
    text-decoration: none;
    padding: 8px 11px;
    border-radius: 7px;
    font-size: 14px;
}

nav a:hover {
    background: #b7ff35;
    color: #063d25;
}

.container {
    max-width: 1200px;
    margin: auto;
    padding: 20px;
}

.hero {
    background: white;
    border-radius: 16px;
    padding: 25px;
    margin-bottom: 20px;
    box-shadow: 0 3px 12px rgba(0,0,0,0.08);
    text-align: center;
}

.hero h2 {
    color: #075b34;
    margin-top: 0;
}

.hero p {
    line-height: 1.6;
}

.balance {
    background: linear-gradient(135deg, #063d25, #0b6b3d);
    color: white;
    border-radius: 18px;
    padding: 30px 20px;
    text-align: center;
    margin-bottom: 20px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.15);
}

.balance-title {
    font-size: 18px;
    margin-bottom: 10px;
}

.balance-amount {
    font-size: 42px;
    font-weight: bold;
    color: #b7ff35;
