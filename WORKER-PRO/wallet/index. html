<script>

let walletBalance = 250;

function topUp() {

    document.getElementById("topupAmount").focus();

    window.scrollTo({
        top: document.querySelector(".form-box").offsetTop - 80,
        behavior: "smooth"
    });

}

function processTopUp() {

    const input = document.getElementById("topupAmount");

    const amount = parseFloat(input.value);

    if (!amount || amount <= 0) {

        alert("Введите корректную сумму.");

        return;
    }

    alert(
        "Демо-операция.\n\n" +
        "Пополнение на " +
        amount.toFixed(2) +
        " AZN будет доступно после подключения реальной платёжной системы."
    );

    input.value = "";

}

function showWithdraw() {

    alert(
        "Вывод средств пока находится в разработке.\n\n" +
        "В будущем здесь можно будет выбрать банковский счёт или другой способ вывода."
    );

}

function showTransactions() {

    document.getElementById("transactions").scrollIntoView({
        behavior: "smooth"
    });

}

function changeCurrency() {

    const currency = document.getElementById("currency").value;

    const info = document.getElementById("currencyInfo");

    if (currency === "AZN") {

        info.textContent = "Основная валюта: AZN — Манат";

    } else if (currency === "USD") {

        info.textContent = "Выбрана валюта: USD — Dollar";

    } else if (currency === "EUR") {

        info.textContent = "Выбрана валюта: EUR — Euro";

    } else if (currency === "TRY") {

        info.textContent = "Выбрана валюта: TRY — Turkish Lira";

    }

}

function openPage(url) {

    window.location.href = url;

}

</script>

