<script>

let currentCurrency = "AZN";

let demoBalanceAZN = 250;

const rates = {
    AZN:1,
    USD:0.588,
    EUR:0.545,
    TRY:26.7
};


function changeCurrency(currency){

    currentCurrency = currency;

    document.querySelectorAll(".currency button")
        .forEach(function(button){

            button.classList.remove("active");

        });


    if(currency === "AZN"){
        document.getElementById("aznBtn")
            .classList.add("active");
    }

    if(currency === "USD"){
        document.getElementById("usdBtn")
            .classList.add("active");
    }

    if(currency === "EUR"){
        document.getElementById("eurBtn")
            .classList.add("active");
    }

    if(currency === "TRY"){
        document.getElementById("tryBtn")
            .classList.add("active");
    }

    updateBalanceDisplay();

    updateDepositPreview();

    updateWalletPayment();

}


function convertFromAZN(amount){

    return amount * rates[currentCurrency];

}


function updateBalanceDisplay(){

    const value =
        convertFromAZN(demoBalanceAZN);

    document.getElementById("balance")
        .textContent =
        value.toFixed(2) +
        " " +
        currentCurrency;

    document.getElementById("walletPaymentBalance")
        .textContent =
        value.toFixed(2) +
        " " +
        currentCurrency;

    document.getElementById("depositCurrency")
        .textContent =
        currentCurrency;

}


function updateDepositPreview(){

    const input =
        document.getElementById("depositAmount");

    const amount =
        parseFloat(input.value) || 0;

    document.getElementById("depositPreview")
        .textContent =
        amount.toFixed(2) +
        " " +
        currentCurrency;

}


document.getElementById("depositAmount")
    .addEventListener(
        "input",
        updateDepositPreview
    );


function showDeposit(){

    document.getElementById("depositAmount")
        .focus();

    window.scrollTo({
        top:
        document.querySelector(".form-box")
        .offsetTop - 80,
        behavior:"smooth"
    });

}


function showPayment(){

    const section =
        document.getElementById("walletService");

    section.focus();

    window.scrollTo({
        top:
        section.offsetTop - 100,
        behavior:"smooth"
    });

}


function showRefund(){

    alert(
        "Запрос на возврат\n\n" +
        "В будущем здесь будет форма " +
        "для оформления возврата средств.\n\n" +
        "Сейчас работает демо-режим."
    );

}


function scrollToHistory(){

    document.getElementById("history")
        .scrollIntoView({
            behavior:"smooth"
        });

}


function depositMoney(){

    const input =
        document.getElementById("depositAmount");

    const amount =
        parseFloat(input.value);

    const method =
        document.getElementById("depositMethod")
        .value;

    if(!amount || amount <= 0){

        alert(
            "Введите сумму пополнения."
        );

        return;
    }


    const amountAZN =
        amount / rates[currentCurrency];

    demoBalanceAZN += amountAZN;

    updateBalanceDisplay();

    input.value = "";

    updateDepositPreview();

    alert(
        "Баланс пополнен в демо-режиме!\n\n" +
        "Сумма: " +
        amount.toFixed(2) +
        " " +
        currentCurrency +
        "\n" +
        "Способ: " +
        method +
        "\n\n" +
        "Реальные деньги не списываются."
    );

}


function updateWalletPayment(){

    const select =
        document.getElementById("walletService");

    const basePrice =
        parseFloat(select.value);

    const price =
        convertFromAZN(basePrice);

    document.getElementById("walletPaymentPrice")
        .textContent =
        price.toFixed(2) +
        " " +
        currentCurrency;

}


function payFromWallet(){

    const select =
        document.getElementById("walletService");

    const selectedText =
        select.options[
            select.selectedIndex
        ].text;

    const basePrice =
        parseFloat(select.value);

    if(demoBalanceAZN < basePrice){

        alert(
            "Недостаточно средств.\n\n" +
            "Баланс: " +
            convertFromAZN(demoBalanceAZN)
            .toFixed(2) +
            " " +
            currentCurrency
        );

        return;
    }


    demoBalanceAZN -= basePrice;

    updateBalanceDisplay();

    updateWalletPayment();

    alert(
        "Оплата выполнена в демо-режиме!\n\n" +
        "Услуга: " +
        selectedText +
        "\nСумма: " +
        convertFromAZN(basePrice)
        .toFixed(2) +
        " " +
        currentCurrency +
        "\n\n" +
        "Реальные деньги не списываются."
    );

}


updateBalanceDisplay();

updateDepositPreview();

updateWalletPayment();

</script>

