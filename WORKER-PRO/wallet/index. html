    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
}

.balance-buttons button {
    border: none;
    border-radius: 9px;
    padding: 12px 18px;
    cursor: pointer;
    font-weight: bold;
    background: #b7ff35;
    color: #063d25;
}

.balance-buttons button:hover {
